<?php

namespace App\Services;

use App\Models\QrPlate;
use App\Models\Pet;
use Illuminate\Support\Facades\DB;

class QrAssignmentService
{
    public function assignToPet(QrPlate $qr, Pet $pet)
    {
        DB::transaction(function () use ($qr, $pet) {

            $qr = QrPlate::lockForUpdate()->find($qr->id);

            if ($qr->status >= QrPlate::STATUS_ASSIGNED) {
                throw new \Exception('QR no disponible');
            }

            // Reemplazar QR anterior de la mascota
            QrPlate::where('pet_id', $pet->id)
                ->where('status', QrPlate::STATUS_ASSIGNED)
                ->update([
                    'status' => QrPlate::STATUS_REPLACED,
                    'replaced_at' => now()
                ]);

            // Asignar el nuevo QR a la mascota
            $qr->update([
                'pet_id' => $pet->id,
                'status' => QrPlate::STATUS_ASSIGNED,
                'assigned_at' => now()
            ]);
        });
    }
}
